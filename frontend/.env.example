# Base URL for direct cross-origin API requests (leave blank in dev to use Vite's /api proxy)
# Production SPA hosting example (Cloudflare Pages / Netlify / Vercel): https://your-site.runasp.net
VITE_API_BASE_URL=

# Target URL used by Vite's local development proxy for /api, /images/people/student-*, /health, and /openapi
VITE_API_PROXY_TARGET=http://localhost:5186
