root = true

[*.cs]
# BaseResponse<T> intentionally provides static factory methods (Ok/Fail).
dotnet_diagnostic.CA1000.severity = none
# Locale-invariant formatting is passed explicitly on headers, CSV, and digest numbers; general API formatting uses server culture defaults.
dotnet_diagnostic.CA1305.severity = none
# IDomainEventHandler<T> follows standard DDD naming rather than .NET delegate EventHandler suffixes.
dotnet_diagnostic.CA1711.severity = none
# Domain entity TeamUp.Domain.Entities.Event is an intentional domain concept name.
dotnet_diagnostic.CA1716.severity = none

[src/**/Persistence/Migrations/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1062.severity = none
