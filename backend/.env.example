# ====================================================================
# TeamUp ASP.NET Core 11 Web API - Environment Configuration Example
# ====================================================================

# Runtime Host
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5186

# Database Provider & Connection Strings
# Options for DatabaseProvider: "SqlServer" | "Sqlite"
DatabaseProvider=SqlServer
ConnectionStrings__TeamUpDb=Server=.\SQLEXPRESS;Database=TeamUpDb;Trusted_Connection=True;TrustServerCertificate=True;
ConnectionStrings__SqliteFallback=Data Source=TeamUp.dev.db
UseSqliteFallbackIfOffline=true
Database__AutoMigrate=true

# JWT Authentication (must be at least 32 UTF-8 bytes)
Jwt__Issuer=TeamUp
Jwt__Audience=TeamUp.Clients
Jwt__Key=DevelopmentOnlyLocalSigningKeyForTeamUpMustBeOverriddenInProd32B!
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
Jwt__PasswordResetTokenMinutes=15

# Seeding & Fixtures
Seed__Enabled=true
Seed__AdminPassword=DevelopmentSeedPassword2026!

# Email Service
Email__Provider=InMemory

# Rate Limiting
RateLimiting__UploadPermitLimit=10
Email__FrontendBaseUrl=http://localhost:5173
Email__FromAddress=no-reply@teamup.edu
Email__FromName=TeamUp Platform

# CORS (Frontend Origins)
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:4173
Cors__AllowedOrigins__2=http://127.0.0.1:5173
Cors__AllowedOrigins__3=http://127.0.0.1:4173
