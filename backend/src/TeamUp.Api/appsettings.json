{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "ConnectionStrings": {},
  "Jwt": {
    "Issuer": "TeamUp",
    "Audience": "TeamUp.Clients",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "PasswordResetTokenMinutes": 15
  },
  "Email": {
    "Provider": "Smtp",
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "FromAddress": "no-reply@teamup.edu",
    "FromName": "TeamUp Platform",
    "ResetPasswordUrlBase": "https://teamup.edu/reset-password"
  },
  "Admin": {
    "AllowRuntimePlatformAdminPromotion": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 30,
    "AuthenticatedPermitLimit": 120,
    "AnonymousPermitLimit": 30,
    "DirectoryPermitLimit": 30,
    "WindowSeconds": 60
  },
  "Seed": {
    "Enabled": false
  }
}
