{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://your-frontend.pages.dev",
      "https://your-frontend.netlify.app",
      "https://your-frontend.vercel.app"
    ]
  },
  "ConnectionStrings": {
    "TeamUpDb": "Server=dbXXXX.public.databaseasp.net;Database=dbXXXX;User Id=dbXXXX;Password=REPLACE_WITH_DB_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "Issuer": "TeamUp",
    "Audience": "TeamUp.Clients",
    "Key": "REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS_GENERATED_SECURELY",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "PasswordResetTokenMinutes": 15
  },
  "Email": {
    "Provider": "Smtp",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "FromAddress": "no-reply@teamup.edu",
    "FromName": "TeamUp Platform",
    "ResetPasswordUrlBase": "https://your-frontend.pages.dev/auth/reset-password"
  },
  "Hosting": {
    "EnableHttpsRedirection": true
  },
  "Database": {
    "AutoMigrate": true
  },
  "Seed": {
    "Enabled": false
  }
}
