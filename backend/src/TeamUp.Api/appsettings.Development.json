{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:4173"
    ]
  },
  "ConnectionStrings": {
    "TeamUpDb": "Server=.\\SQLEXPRESS;Database=TeamUpDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "SqliteFallback": "Data Source=TeamUp.dev.db"
  },
  "Jwt": {
    "Key": "DevelopmentOnlyLocalSigningKeyForTeamUpMustBeOverriddenInProd32B!"
  },
  "Email": {
    "Provider": "InMemory",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "UseSqliteFallbackIfOffline": true,
  "Seed": {
    "Enabled": true
  }
}
